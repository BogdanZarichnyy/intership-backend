            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Зберігаємо токени після успішного логіну\r",
                  "if (pm.response.code === 200) {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.collectionVariables.set(\"auth0_access_token\", jsonData.auth0_access_token);\r",
                  "    pm.collectionVariables.set(\"auth0_id_token\", jsonData.auth0_id_token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "https://dev-ja1yqcpfw2odtfhp.eu.auth0.com/oauth/token",
              "protocol": "https",
