        {
          "name": "User Authorization with Auth0 id_token on callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// зберігаємо токен після успішного логіну\r",
                  "if (pm.response.code === 200) {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.access_token);\r",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh_token);\r",
                  "    console.log(\"Token updated:\", jsonData.access_token);\r",
                  "    console.log(\"Refresh Token updated:\", jsonData.refresh_token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Зберігаємо токени, які повернув сервіс auth0\r",
                  "if (pm.response.code === 200) {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.collectionVariables.get(\"auth0_access_token\", data.auth0_access_token);\r",
                  "    pm.collectionVariables.get(\"auth0_id_token\", data.auth0_id_token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"access_token\": \"{{auth0_access_token}}\",\r\n  \"id_token\": \"{{auth0_id_token}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8000/auth/callback",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "auth",
                "callback"
              ]
            }
          },
          "response": []
        },
