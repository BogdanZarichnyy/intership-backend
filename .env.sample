# Backend
HOST=0.0.0.0
PORT=8000
DEBUG=False/True
CORS_ORIGINS=["http://localhost:3000"]

# --- Параметри повторних спроб запуску БД ---
MAX_RETRIES = 5  # кількість спроб підключення до БД
RETRY_DELAY = 2  # секунди

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_TTL_SECONDS=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth0 Configuration
AUTH0_ALGORITHM=RS256 # Auth0 завжди RS256, але його можна змінити на сайті сервісу
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
AUTH0_REDIRECT_URI=
FRONTEND_REDIRECT_URL=